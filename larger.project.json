{
  "$schema": "./schemas/larger-project.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "desprets.net",
    "root": "../desprets.net",
    "entryRoute": "/",
    "dev": {
      "command": [
        "pnpm",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "{port}"
      ],
      "host": "127.0.0.1",
      "preferredPort": 3100
    },
    "engine": {
      "adapter": "react-rewrite",
      "mode": "sandbox"
    }
  }
}

