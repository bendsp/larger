{
  "name": "larger",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "main": ".larger/electron/main.cjs",
  "description": "A visual design studio for React projects.",
  "scripts": {
    "dev": "concurrently --kill-others --names studio,electron --prefix-colors magenta,yellow \"pnpm:dev:studio\" \"pnpm:dev:electron\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:studio": "vite --host 127.0.0.1",
    "dev:electron": "pnpm build:electron && wait-on http://127.0.0.1:4310 && electron .larger/electron/main.cjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm typecheck && pnpm build:electron && vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:electron && vite build && tsx --test server/*.test.ts electron/**/*.test.ts test/**/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.12.2",
    "react-rewrite-cli": "0.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "electron": "43.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "wait-on": "^8.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
