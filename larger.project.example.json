{
  "$schema": "./schemas/larger-project.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "my-app",
    "root": "../my-app",
    "entryRoute": "/",
    "dev": {
      "command": ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "{port}"],
      "host": "127.0.0.1",
      "preferredPort": 3100
    },
    "engine": {
      "adapter": "react-rewrite",
      "mode": "sandbox"
    }
  }
}
