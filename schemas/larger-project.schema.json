{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larger.design/schemas/larger-project.schema.json",
  "title": "Larger project manifest",
  "description": "Project-owned, versioned configuration stored at .larger/project.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "defaultRuntimeProfile", "runtimeProfiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "description": "Stable logical identity that remains unchanged when the project moves or is cloned."
    },
    "name": { "type": "string", "minLength": 1 },
    "defaultRuntimeProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "runtimeProfiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/runtimeProfile" }
    }
  },
  "$defs": {
    "relativeProjectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "description": "A path relative to the project root. Absolute paths and parent traversal are forbidden."
    },
    "commandArgument": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z0-9_]*(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy])[A-Za-z0-9_]*=" },
          { "pattern": "^--?(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][-_]?[Kk][Ee][Yy])(?:=|$)" }
        ]
      },
      "description": "One argv entry. Credentials belong in the launch environment, never in the project manifest."
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["literals", "inherit", "secrets"],
      "properties": {
        "literals": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              { "$ref": "#/$defs/environmentName" },
              { "not": { "pattern": "(?:TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|PRIVATE_KEY)" } }
            ]
          },
          "additionalProperties": { "type": "string" }
        },
        "inherit": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/environmentName" }
        },
        "secrets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/environmentName" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          }
        }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "dependencyRoot", "host", "preferredPort", "readiness", "entryRoute", "environment", "runtimeAdapter", "editorAdapter"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandArgument" }
        },
        "workingDirectory": { "$ref": "#/$defs/relativeProjectPath" },
        "dependencyRoot": { "$ref": "#/$defs/relativeProjectPath" },
        "host": { "const": "127.0.0.1" },
        "preferredPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "timeoutMs"],
          "properties": {
            "path": { "type": "string", "pattern": "^/(?!/)" },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
          }
        },
        "entryRoute": { "type": "string", "pattern": "^/(?!/)" },
        "environment": { "$ref": "#/$defs/environment" },
        "runtimeAdapter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "editorAdapter": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
