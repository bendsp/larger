{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larger.design/schemas/larger-project.schema.json",
  "title": "Larger project manifest",
  "description": "Project-owned, versioned configuration stored at .larger/project.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "defaultRuntimeProfile", "runtimeProfiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "description": "Stable logical identity that remains unchanged when the project moves or is cloned."
    },
    "name": { "type": "string", "minLength": 1 },
    "defaultRuntimeProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "runtimeProfiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/runtimeProfile" }
    }
  },
  "$defs": {
    "relativeProjectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "description": "A path relative to the project root. Absolute paths and parent traversal are forbidden."
    },
    "commandArgument": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z0-9_]*(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy])[A-Za-z0-9_]*=" },
          { "pattern": "^--?(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][-_]?[Kk][Ee][Yy])(?:=|$)" }
        ]
      },
      "description": "One argv entry. Credentials belong in the launch environment, never in the project manifest."
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "host", "preferredPort", "entryRoute", "editorAdapter"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandArgument" }
        },
        "workingDirectory": { "$ref": "#/$defs/relativeProjectPath" },
        "host": { "enum": ["127.0.0.1", "localhost"] },
        "preferredPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "entryRoute": { "type": "string", "pattern": "^/(?!/)" },
        "editorAdapter": { "type": "string", "minLength": 1 }
      }
    }
  }
}
