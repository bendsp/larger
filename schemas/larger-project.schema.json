{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larger.dev/schemas/larger-project.schema.json",
  "title": "Larger project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "dev", "engine"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "entryRoute": { "type": "string", "pattern": "^/(?!/)", "default": "/" },
        "dev": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "host", "preferredPort"],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "host": { "enum": ["127.0.0.1", "localhost"] },
            "preferredPort": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "mode"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1 },
            "mode": { "const": "sandbox" }
          }
        }
      }
    }
  }
}
